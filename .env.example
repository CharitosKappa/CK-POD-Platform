# Runtime
NODE_ENV=development
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=

# Local infrastructure (development only; never use these values in production)
DATABASE_URL=postgresql://letitbe:letitbe@127.0.0.1:15432/letitbe
REDIS_URL=redis://localhost:6379

# Adapters
STORAGE_DRIVER=memory
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
QUEUE_DRIVER=redis

# AI orchestration (development-only deterministic adapters; no paid API calls)
AI_GUEST_FREE_CREDITS=1
AI_REGISTERED_FREE_CREDITS=0
AI_MAX_REFERENCE_ASSETS=5
AI_PROVIDER_CONFIG=[{"id":"development-primary","adapter":"deterministic-svg","enabled":true,"tasks":["TEXT_TO_ARTWORK","SELECTED_ELEMENT_EDITING"],"model":"development-svg-v1","priority":10,"estimatedCostCents":0,"timeoutMs":5000,"maxRetries":0,"fallbackEligible":true},{"id":"development-fallback","adapter":"deterministic-pattern","enabled":true,"tasks":["TEXT_TO_ARTWORK","SELECTED_ELEMENT_EDITING"],"model":"development-pattern-v1","priority":20,"estimatedCostCents":0,"timeoutMs":5000,"maxRetries":0,"fallbackEligible":true}]

# Editor (development-safe defaults)
NEXT_PUBLIC_EDITOR_UNDO_LIMIT=50
NEXT_PUBLIC_EDITOR_AUTOSAVE_DEBOUNCE_MS=700

# Prepress (leave empty to use bundled workspace fonts in local development)
PREPRESS_FONT_ROOT=

# Fulfillment (fake by default; real Printify calls require explicit server-only configuration)
FULFILLMENT_ADAPTER=fake
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_API_BASE_URL=https://api.printify.com/v1
PRINTIFY_WEBHOOK_SECRET=

# Commerce (fake by default; Stripe remains behind the PaymentService adapter)
PAYMENT_ADAPTER=fake
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com/v1
# Development-only fake tax rate; production tax configuration remains gated by G4.
DEVELOPMENT_TAX_RATE_BASIS_POINTS=0
TAX_ADAPTER=fake

# Lifecycle (fake is mandatory default for local/CI; Klaviyo requires an explicit server-only key)
LIFECYCLE_ADAPTER=fake
KLAVIYO_API_KEY=
KLAVIYO_API_BASE_URL=https://a.klaviyo.com/api
LIFECYCLE_GENERATED_NO_PURCHASE_DELAY_MS=86400000
LIFECYCLE_CART_ABANDONMENT_DELAY_MS=3600000
LIFECYCLE_CHECKOUT_ABANDONMENT_DELAY_MS=1800000
LIFECYCLE_REORDER_REVISIT_DELAY_MS=2592000000
LIFECYCLE_PROCESS_INTERVAL_MS=60000
