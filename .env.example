# Runtime
NODE_ENV=development
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=

# Local infrastructure (development only; never use these values in production)
